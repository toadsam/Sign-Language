EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# AI가 만든 수어 동작 (통역 화면의 3D 친구)
# 비워 두면 EXPO_PUBLIC_API_BASE_URL 의 /api/sign/generate 로 물어보고, 못 받으면 조용히 영상으로 보여 준다.
# 문장 모델은 VM 에서 돈다. VM 을 포트로 연결했을 때는 아래처럼 적는다 (이때는 못 받으면 화면에 까닭을 알린다).
# EXPO_PUBLIC_SIGN_GENERATE_URL=http://localhost:8080/api/sign/generate
# 아예 묻지 않게 하려면
# EXPO_PUBLIC_MOTION_API=off

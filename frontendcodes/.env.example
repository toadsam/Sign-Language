EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=987382520137-r0bo3q42ednnk7rs9ofjm44cnsk5in40.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# AI가 만든 수어 동작 (통역 화면의 3D 친구)
# 비워 두면 EXPO_PUBLIC_API_BASE_URL 의 /api/sign/generate 로 물어보고, 못 받으면 조용히 영상으로 보여 준다.
# 문장 모델은 VM 에서 돈다. VM 을 포트로 연결했을 때는 아래처럼 적는다 (이때는 못 받으면 화면에 까닭을 알린다).
# EXPO_PUBLIC_SIGN_GENERATE_URL=http://localhost:8080/api/sign/generate
# 아예 묻지 않게 하려면
# EXPO_PUBLIC_MOTION_API=off

# 읽는 모델 (따라 하기 뒤에 나오는 "읽는 모델이 읽은 단어" 표)
# 위 EXPO_PUBLIC_SIGN_GENERATE_URL 을 적어 두면 그 주소의 끝 /generate 를 /recognize 로 바꿔 묻는다.
# 따로 정하려면 아래처럼 적는다. 둘 다 없으면 묻지 않고 표도 나오지 않는다.
# EXPO_PUBLIC_SIGN_RECOGNIZE_URL=http://localhost:8080/api/sign/recognize
# 서버 쪽: 추론 서버는 SIGN_RECOG_RUN_DIR(읽는 모델 run 폴더), Spring 은 SIGN_RECOGNITION_URL(비우면 생성 주소에서 따라 정함)
